{
  "name": "@adaptive-ds/outscraper-client",
  "version": "0.1.0",
  "description": "TypeScript Result-based API client for Outscraper (Google Maps, Reviews, Leads, Emails, Serp, and Business Search). Type-safe, Valibot-validated, and modern.",
  "keywords": [
    "outscraper",
    "outscraper-api",
    "google-maps-scraper",
    "google-reviews",
    "leads",
    "email-extractor",
    "api-client",
    "typescript",
    "result",
    "valibot"
  ],
  "homepage": "https://github.com/david1gp/outscraper-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/outscraper-client.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/outscraper-client/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "outscraper-client": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun test --watch",
    "test": "bun test",
    "test:task1": "bun test test/openApiGeneration.test.ts",
    "test:w": "bun test --watch",
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json && chmod +x ./dist/cli.js",
    "check": "bun tsc --noEmit",
    "cli": "bun src/cli.ts",
    "openapi:snapshot": "bun scripts/openapi-snapshot.ts",
    "openapi:normalize": "bun scripts/openapi-normalize.ts",
    "generate": "bun scripts/openapi-generate.ts && biome format --write src",
    "release": "bash ./ops/release.sh",
    "update": "bun update",
    "format": "biome format --write src scripts test package.json tsconfig.json tsconfig.lib.json biome.json",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3",
    "valibot": "^1.2.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@stricli/core": "^1.2.5"
  }
}
